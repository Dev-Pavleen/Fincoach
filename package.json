{
  "name": "fincoach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace client run build && node scripts/prepare-vercel.mjs",
    "start": "npm --workspace server run start",
    "test": "npm --workspace server test && npm --workspace client test"
  },
  "dependencies": {
    "serverless-http": "^4.0.0"
  },
  "devDependencies": { "concurrently": "^9.2.1" },
  "engines": { "node": ">=20.19" }
}
